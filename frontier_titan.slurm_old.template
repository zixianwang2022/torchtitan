#!/bin/bash

#SBATCH -A gen150
#SBATCH -J {{JOB_NAME}}
#SBATCH -o logs/%j-{{JOB_NAME}}.o
#SBATCH -e logs/%j-{{JOB_NAME}}.e
#SBATCH -t 00:10:00
#SBATCH -p batch
#SBATCH -N {{NODES}}
#SBATCH -d singleton
#a SBATCH -q debug

# --- 1. Templatized Variable Definitions ---
JOB_NAME="{{JOB_NAME}}"
NODES={{NODES}}
GPUS_PER_NODE={{GPUS_PER_NODE}}
PP_SIZE={{PP_SIZE}}
EP_SIZE={{EP_SIZE}}
MICRO_BATCH_SIZE={{MICRO_BATCH_SIZE}}
NUM_MICRO_BATCHES={{NUM_BATCHES}}
LOCAL_BATCH_SIZE={{LOCAL_BATCH_SIZE}}
GLOBAL_BATCH_SIZE={{GLOBAL_BATCH_SIZE}}
TRAIN_ITERS={{TRAIN_ITERS}}
MODEL_SIZE="{{MODEL_SIZE}}"
ACTIVATION_CHECKPOINT="{{AC_MODE}}"
CONFIG_FILE="{{GENERATED_CONFIG_PATH}}"
TOTAL_GPUS={{TOTAL_AVAIL_GPUS}}
SEQ_LEN={{SEQ_LEN}}

echo "------------------------------------------------------"
echo "JOB CONFIGURATION:"
echo "JOB_NAME: $JOB_NAME"
echo "NODES: $NODES"
echo "GPUS_PER_NODE: $GPUS_PER_NODE"
echo "PP_SIZE: $PP_SIZE"
echo "EP_SIZE: $EP_SIZE"

echo "MICRO_BATCH_SIZE: $MICRO_BATCH_SIZE"
echo "NUM_MICRO_BATCHES: $NUM_MICRO_BATCHES"
echo "LOCAL_BATCH_SIZE (Calculated): $LOCAL_BATCH_SIZE"

echo "TRAIN_ITERS: $TRAIN_ITERS"
echo "MODEL_SIZE: $MODEL_SIZE"
echo "ACTIVATION_CHECKPOINT: $ACTIVATION_CHECKPOINT"
echo "CONFIG_FILE: $CONFIG_FILE"
echo "SEQ_LEN: $SEQ_LEN"
echo "------------------------------------------------------"


export TITAN_HOME=/lustre/orion/gen150/scratch/zixianw4/torchtitan
export PATH=$TITAN_HOME/bin:$PATH

# --- 3. Network Configuration (Slingshot/HPE) ---
export HIGH_SPEED_INTERFACE="hsn0"
export NCCL_SOCKET_IFNAME=${HIGH_SPEED_INTERFACE}
export NCCL_NET_GDR_LEVEL=3
export NCCL_CROSS_NIC=0

export FI_MR_CACHE_MONITOR=kdreg2
export FI_CXI_DEFAULT_CQ_SIZE=262144
export FI_CXI_DEFAULT_TX_SIZE=8196
export FI_CXI_RX_MATCH_MODE=hybrid

# --- 4. Torch Settings ---
export OMP_NUM_THREADS=7
export CUDA_DEVICE_MAX_CONNECTIONS=1
# export NCCL_DEBUG=WARN
# export NCCL_DEBUG=INFO
export PYTHONFAULTHANDLER=1
export CUDA_LAUNCH_BLOCKING=0

export TORCH_NCCL_HEARTBEAT_TIMEOUT_SEC=1500

# --- 5. Master Node Discovery ---
export MASTER_PORT=29500
nodes=( $( scontrol show hostnames $SLURM_JOB_NODELIST ) )
head_node=${nodes[0]}

export MASTER_ADDR=$(ssh $head_node "ip -4 addr show ${HIGH_SPEED_INTERFACE} | grep 'inet' | awk '{print \$2}' | cut -d/ -f1")

if [[ -z "${MASTER_ADDR}" ]]; then
    echo "FATAL: Could not determine MASTER_ADDR."
    exit 1
fi

echo "Head Node: $head_node ($MASTER_ADDR)"

# --- 6. Proxy Settings ---
export all_proxy=socks5://proxy.ccs.ornl.gov:3128/
export ftp_proxy=ftp://proxy.ccs.ornl.gov:3128/
export http_proxy=http://proxy.ccs.ornl.gov:3128/
export https_proxy=http://proxy.ccs.ornl.gov:3128/
export no_proxy="localhost,127.0.0.0/8,*.ccs.ornl.gov,*.ncrc.gov,.olcf.ornl.gov,*.frontier.olcf.ornl.gov,${head_node}"

# --- 7. Hugging Face Settings ---
export HF_HOME=/lustre/orion/gen150/scratch/zixianw4/huggingface_cache
export HF_HUB_DOWNLOAD_TIMEOUT=600
export HF_HTTP_TIMEOUT=600

# --- 8. Warmup ---
# Run single process on head node to cache files and prevent proxy overload
# echo "Starting Dataset Warmup..."
# python3 -c "
# import os
# from datasets import load_dataset_builder, load_dataset
# os.environ['HF_HUB_DOWNLOAD_TIMEOUT'] = '600'
# try:
#     builder = load_dataset_builder('allenai/c4', 'en')
#     builder._check_manual_download(None)
#     builder._split_generators(None)
# except Exception:
#     pass
# "





# --- 9. Srun Launcher (Pure srun) ---
# Note: We use the bash variables defined at the top ($NODES, $GPUS_PER_NODE, $CONFIG_FILE)

export LAUNCHER="
export RANK=\$SLURM_PROCID
export LOCAL_RANK=\$SLURM_LOCALID
export WORLD_SIZE=\$SLURM_NTASKS
export MASTER_ADDR=$MASTER_ADDR
export MASTER_PORT=$MASTER_PORT
export TORCHINDUCTOR_AUTOTUNE_IN_SUBPROC=1

echo \"Rank \$RANK (Local \$LOCAL_RANK) on \$(hostname)\"

exec python -m torchtitan.train --job.config_file ${CONFIG_FILE} \$@
"



echo "================================================="
echo "DEBUGGING CACHE AND ENVIRONMENT"
echo "Job started at: $(date)"
echo "Running on node: $(hostname)"
echo ""
echo "Inspecting environment variables:"
echo "HOME: $HOME"
echo "TMPDIR: $TMPDIR"
echo "SLURM_TMPDIR: $SLURM_TMPDIR"
echo "TORCH_HOME: $TORCH_HOME"
echo "TRITON_CACHE_DIR: $TRITON_CACHE_DIR"
echo "================================================="

# --- Explicitly Set a Persistent Cache Location (THIS IS THE FIX) ---

# Define a cache directory on your persistent lustre scratch space
export MY_CACHE_DIR="/lustre/orion/gen150/scratch/zixianw4/torch_cache"
mkdir -p $MY_CACHE_DIR
export TORCH_HOME=$MY_CACHE_DIR
export TRITON_CACHE_DIR="$MY_CACHE_DIR/triton"

echo "================================================="
echo "FORCING CACHE LOCATION:"
echo "TORCH_HOME is now: $TORCH_HOME"
echo "TRITON_CACHE_DIR is now: $TRITON_CACHE_DIR"
echo "================================================="



echo "Starting TorchTitan via srun..."


# FIX: Removed --gpu-bind=closest, added --gpu-bind=none to fix device visibility
srun -N $NODES -n $TOTAL_GPUS -c2 \
     --ntasks-per-node=$GPUS_PER_NODE \
     --gpus-per-node=$GPUS_PER_NODE \
     --export=ALL \
     bash -c "$LAUNCHER"



echo "================================================="
echo "Searching for compiled Triton kernels in the forced cache location..."
find $MY_CACHE_DIR -name "*_jit_generated_kernel.py" -ls
echo "Search complete. If you see files listed above, the cache was written successfully."
echo "================================================="



echo "------------------------------------------------------"
echo "--- Post-Run Analysis ---"
echo "------------------------------------------------------"

# 1. Define Model Dimensions based on MODEL_SIZE
if [[ "$MODEL_SIZE" == "10B_titan" ]]; then
    HIDDEN_DIM=2048
    MOE_INTER_DIM=1408
    NUM_LAYERS=28
    NUM_EXPERTS=64
    TOPK=6
elif [[ "$MODEL_SIZE" == "63B_titan" ]]; then
    HIDDEN_DIM=5120
    MOE_INTER_DIM=1536
    NUM_LAYERS=32
    NUM_EXPERTS=128
    TOPK=6
elif [[ "$MODEL_SIZE" == "63B_titan_4L" ]]; then
    HIDDEN_DIM=5120
    MOE_INTER_DIM=1536
    NUM_LAYERS=32
    NUM_EXPERTS=128
    TOPK=6
elif [[ "$MODEL_SIZE" == "173B_titan" ]]; then
    HIDDEN_DIM=7168
    MOE_INTER_DIM=2048
    NUM_LAYERS=24
    NUM_EXPERTS=256
    TOPK=8
elif [[ "$MODEL_SIZE" == "537B_titan" ]]; then
    HIDDEN_DIM=7168
    MOE_INTER_DIM=2048
    NUM_LAYERS=60
    NUM_EXPERTS=256
    TOPK=8
elif [[ "$MODEL_SIZE" == "1T_titan" ]]; then
    HIDDEN_DIM=7168
    MOE_INTER_DIM=2048
    NUM_LAYERS=60
    NUM_EXPERTS=512
    TOPK=8
elif [[ "$MODEL_SIZE" == "16B" ]] || [[ "$MODEL_SIZE" == "16B_titan" ]]; then
    # Fallback for original 16B config
    HIDDEN_DIM=2048
    MOE_INTER_DIM=1408
    NUM_LAYERS=27
    NUM_EXPERTS=64
    TOPK=6
else
    # Safety Fallback
    echo "WARNING: Unknown model size $MODEL_SIZE, using 16B defaults"
    HIDDEN_DIM=2048
    MOE_INTER_DIM=1408
    NUM_LAYERS=27
    NUM_EXPERTS=64
    TOPK=6
fi

# 2. Path to log file
LOG_FILE="logs/${SLURM_JOB_ID}-${JOB_NAME}.o" 

# 3. Call the Python Analyzer
# Note: --expert_dim maps to MOE_INTER_DIM in your configs
python analyze_titan_log.py "${LOG_FILE}" \
    --slurm_job_id "$SLURM_JOB_ID" \
    --model_size "$MODEL_SIZE" \
    --moe_type "TorchTitan" \
    --nodes $NODES \
    --gpus_per_node $GPUS_PER_NODE \
    --pp $PP_SIZE \
    --ep $EP_SIZE \
    --dp $(( TOTAL_GPUS / PP_SIZE / EP_SIZE )) \
    --tp 1 \
    --gbs $GLOBAL_BATCH_SIZE \
    --mbs $MICRO_BATCH_SIZE \
    --iterations $TRAIN_ITERS \
    --seqlen $SEQ_LEN \
    --num_layers $NUM_LAYERS \
    --hidden_dim $HIDDEN_DIM \
    --num_experts $NUM_EXPERTS \
    --expert_dim $MOE_INTER_DIM \
    --topk $TOPK \
    --activation_checkpointing "$ACTIVATION_CHECKPOINT" \
    --pp_schedule "{{PP_SCHEDULE}}"